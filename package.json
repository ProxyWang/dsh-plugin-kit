{
  "name": "dsh-plugin-kit",
  "version": "1.5.0",
  "description": "Harness developer workspace: code IDE with a multi-tab editor, LSP navigation, search, Git review, API client, file browser, and skills manager.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://gitee.com/wang-jun-07/dsh-plugin-kit.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./host/*": "./lib/host/*.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node scripts/build-client.mjs && node test-host.mjs && node test-client.mjs && node test-search.mjs && node test-nested.mjs && node test-parent.mjs && node test-remote.mjs"
  },
  "icon": "icon.svg",
  "files": [
    "index.js",
    "client.js",
    "src/client/*.js",
    "lib/host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
